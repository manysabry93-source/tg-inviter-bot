{
  "name": "tg-inviter-bot",
  "version": "1.0.0",
  "description": "Telegram Inviter Bot on Cloudflare Workers + D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tg-bot-db --file=schema.sql",
